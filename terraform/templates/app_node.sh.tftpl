#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user || true

SELF_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)

cat >/etc/assignment4-kv.env <<EOF
NODE_ROLE=${node_role}
NODE_FOLLOWER_URLS=${follower_urls}
NODE_PEER_URLS=${peer_urls}
NODE_SELF_URL=http://$SELF_IP:${app_port}
NODE_WRITE_QUORUM_SIZE=${write_quorum_size}
NODE_READ_QUORUM_SIZE=${read_quorum_size}
SERVER_PORT=${app_port}
EOF

if [ -n "${app_image}" ]; then
  docker pull ${app_image}
  docker rm -f assignment4-kv || true
  docker run -d \
    --name assignment4-kv \
    --restart unless-stopped \
    --env-file /etc/assignment4-kv.env \
    -p ${app_port}:8080 \
    ${app_image}
fi
